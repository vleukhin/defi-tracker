{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "seed:admin": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/seed-admin.ts",
    "data:export": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/export-data.ts",
    "data:import": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/import-data.ts",
    "seed:admin:prod": "node --env-file=.env.production.local scripts/seed-admin.ts --remote",
    "data:export:prod": "node --env-file=.env.production.local scripts/export-data.ts --remote",
    "data:import:prod": "node --env-file=.env.production.local scripts/import-data.ts --remote",
    "backfill": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/backfill-snapshots.ts",
    "backfill:prod": "node --env-file=.env.production.local scripts/backfill-snapshots.ts --remote"
  },
  "dependencies": {
    "@bgd-labs/aave-address-book": "^4.44.22",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.111.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.16.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "viem": "^2.55.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "supabase": "^2.110.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
