# Скопируйте в .env.local и заполните. Реальные секреты НИКОГДА не коммитить.

# Supabase (локально: значения из `npx supabase start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Только для сервера (обходит RLS — не использовать в браузерном коде)
SUPABASE_SERVICE_ROLE_KEY=

# RPC (Alchemy, 4 сети: Ethereum / Arbitrum / Base / Optimism)
ALCHEMY_API_KEY=

# CoinGecko Demo API (только с сервера, через общий кэш)
COINGECKO_API_KEY=

# Администратор (публичной регистрации нет). Создание/обновление: npm run seed:admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
