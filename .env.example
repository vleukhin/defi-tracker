# Скопируйте в .env.local и заполните. Реальные секреты НИКОГДА не коммитить.

# Supabase (локально: значения из `npx supabase start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Только для сервера (обходит RLS — не использовать в браузерном коде)
SUPABASE_SERVICE_ROLE_KEY=

# RPC (Alchemy, 4 сети: Ethereum / Arbitrum / Base / Optimism)
ALCHEMY_API_KEY=

# CoinGecko Demo API (только с сервера, через общий кэш)
COINGECKO_API_KEY=

# Секрет cron-роутов: снепшоты (GET /api/cron/snapshot, раз в сутки) и
# мониторинг health factor (GET /api/cron/health, раз в 15 минут).
# Без него роуты отвечают 500, с неверным — 401. Любое случайное значение:
#   openssl rand -hex 32
CRON_SECRET=

# Телеграм-бот для уведомлений о health factor. Токен выдаёт @BotFather
# (/newbot). Один бот на всё приложение; чат каждого пользователя
# привязывается кодом из «Настроек».
# ВАЖНО: у бота не должно быть вебхука — привязка читает getUpdates, и с
# установленным вебхуком телеграм отвечает 409. Снять:
#   curl "https://api.telegram.org/bot<ТОКЕН>/deleteWebhook"
TELEGRAM_BOT_TOKEN=
# Имя бота без «@» — только для ссылки t.me в настройках.
TELEGRAM_BOT_USERNAME=

# Администратор (публичной регистрации нет). Создание/обновление: npm run seed:admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
